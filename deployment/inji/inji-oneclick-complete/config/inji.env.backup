# Cluster
EXPECTED_CONTEXT=default
EXPECTED_NODE=inji-test

# PostgreSQL
PG_SSLMODE=prefer
PG_CLIENT_IMAGE=postgres:16

# Application database credentials

# Deployment safety
ALLOW_DB_INIT=NO
ALLOW_HELM_UPGRADE=NO
ALLOW_EXISTING_UPGRADE=NO

# Inji Certify configuration
CERTIFY_USECASE=mock-identity
PG_NAMESPACE=postgres
PG_HOST=postgres-postgresql.postgres.svc.cluster.local
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_SECRET=postgres-postgresql
PG_ADMIN_SECRET_KEY=postgres-password
APP_PASSWORD_SECRET=inji-db-credentials
APP_PASSWORD_KEY=password
AUTO_CREATE_APP_SECRET=NO
