# eSignet 1.4.0 / Mock Identity 0.12.0 - inji-test
# Based on previously reported RKE2 environment; verify against live cluster.
# Do not commit credentials or this file to a public repository.
EXPECTED_CONTEXT=<REPLACE_ME>
ESIGNET_HOST=<REPLACE_ME>
# REQUIRED: Set the actual public hostname for Mock Relying Party UI.
MOCK_RP_HOST=<REPLACE_ME>
PLUGIN_MODE=<REPLACE_ME>

# Protect existing releases and databases.
ALLOW_DB_INIT=<REPLACE_ME>
ALLOW_EXISTING_DATABASES=<REPLACE_ME>
ALLOW_EXISTING_UPGRADES=<REPLACE_ME>
RUN_KEYCLOAK_INIT=<REPLACE_ME>
MANAGE_CONFIG_SERVER_OVERRIDES=<REPLACE_ME>

# Existing PostgreSQL service and Kubernetes Secret references.
PG_HOST=<REPLACE_ME>
PG_PORT=<REPLACE_ME>
PG_ADMIN_USER=<REPLACE_ME>
PG_ADMIN_SECRET=<REPLACE_ME>
PG_ADMIN_SECRET_KEY=<REPLACE_ME>
DB_COMMON_SECRET=<REPLACE_ME>
DB_COMMON_KEY=<REPLACE_ME>
PG_CLIENT_IMAGE=<REPLACE_ME>

# REQUIRED only if the referenced resources are not already in Kubernetes.
# Absolute path to SOPS-encrypted namespace-aware Kubernetes resources YAML.
ENCRYPTED_RESOURCES=<REPLACE_ME>

# REQUIRED for first-time Keycloak initialization (RUN_KEYCLOAK_INIT=YES).
KEYCLOAK_INIT_PRIVATE_VALUES=<REPLACE_ME>
KEYCLOAK_INIT_PRIVATE_VALUES_SOPS=<REPLACE_ME>

# Optional: only if a custom plugin ConfigMap/Secret has been provisioned.
PLUGIN_CONFIGMAP_NAME=<REPLACE_ME>
PLUGIN_SECRET_NAME=<REPLACE_ME>

HELM_TIMEOUT=<REPLACE_ME>
WAIT_TIMEOUT=<REPLACE_ME>
